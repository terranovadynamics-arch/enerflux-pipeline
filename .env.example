# ============================================================================
#  Deal Hunter — fichier de configuration d'exemple
#  Copiez ce fichier en `.env` puis remplissez vos valeurs.
#  NE COMMITEZ JAMAIS votre .env (il contient vos secrets).
# ============================================================================

# --- Logique métier "bonne affaire" -----------------------------------------
BUDGET_MAX_USD=50000          # Prix demandé maximum pour qu'une annonce soit éligible
DISCOUNT_THRESHOLD=0.12       # Décote minimale (12%) pour déclencher une alerte
SCAM_THRESHOLD=0.45           # Au-delà de cette décote -> "À VÉRIFIER, possible arnaque"
PRICE_WINDOW_DAYS=30          # Fenêtre glissante pour le prix de référence (médiane)
MIN_COMPARABLES=3             # Nb min d'annonces comparables pour fiabiliser la médiane

# --- Boucle de surveillance --------------------------------------------------
POLL_INTERVAL_MIN=30          # Intervalle entre deux passes (minutes)
DB_PATH=dealhunter.db         # Base SQLite (état persistant)
LOG_LEVEL=INFO

# --- Sources -----------------------------------------------------------------
# Liste des sources activées (séparées par des virgules).
# Seul ebay possède une API officielle gratuite. Les autres sont du scraping
# (ToS-sensible) et sont DÉSACTIVÉES par défaut.
ENABLED_SOURCES=ebay
# Mode hors-ligne / démo : utilise les fixtures locales au lieu du réseau.
# Mettez à true pour tester sans clé API ni accès réseau.
USE_FIXTURES=false
# User-agent honnête utilisé pour le scraping poli.
HTTP_USER_AGENT=DealHunterBot/1.0 (+contact: terranovadynamics@gmail.com)
HTTP_RATE_LIMIT_RPS=0.5       # Requêtes/seconde max par source (scraping poli)

# --- eBay Browse API (https://developer.ebay.com/) ---------------------------
# Créez une app gratuite, mode Production, et copiez les identifiants OAuth.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_US      # EBAY_US, EBAY_GB, EBAY_DE, ...

# --- Notifications -----------------------------------------------------------
# Canaux actifs (virgule) : email, telegram
NOTIFY_CHANNELS=email

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=                      # destinataire(s), séparés par des virgules
SMTP_USE_TLS=true

# Telegram (canal secondaire optionnel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
